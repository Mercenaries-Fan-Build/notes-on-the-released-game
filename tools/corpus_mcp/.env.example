# corpus_mcp configuration.
#
# Copy to `.env` (which is gitignored) and uncomment what you want to change.
# Every value below is a DEFAULT baked into src/config.js — the file only needs
# the lines you actually override. A real environment variable always wins over
# this file, so the MCP launcher / shell can still override per-invocation.

# --- Where to index ---------------------------------------------------------
# Root of the tree to index. Default: three levels up from src/ (the repo root).
# Point this at any project to reuse the whole tool elsewhere.
#CORPUS_REPO_ROOT=/path/to/project

# LanceDB storage dir. Default: <repo>/storage/corpus_lancedb
#CORPUS_DB=/path/to/storage/corpus_lancedb

# Table name inside the LanceDB database.
#CORPUS_TABLE=corpus

# Claude Code transcripts + memory. Default: derived from the repo root using
# Claude Code's project-dir encoding (~/.claude/projects/<encoded-root>).
#CORPUS_TRANSCRIPTS_DIR=/path/to/.claude/projects/<encoded>
#CORPUS_MEMORY_DIR=/path/to/.claude/projects/<encoded>/memory

# Ghidra full-decompilation dump, relative to CORPUS_REPO_ROOT.
#CORPUS_GHIDRA_DUMP=output/_ghidra/mercs2_unpacked.exe_decomp.txt

# --- Embedding model --------------------------------------------------------
# transformers.js model id + its output dimensionality. If you change the model
# you MUST change the dim to match and re-ingest with --full (vectors differ).
#CORPUS_EMBED_MODEL=Xenova/bge-small-en-v1.5
#CORPUS_EMBED_DIM=384
# bge wants this prefix on QUERIES only. Other models may want none.
#CORPUS_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# --- Chunking (characters) --------------------------------------------------
#CORPUS_CHUNK_TARGET=1400
#CORPUS_CHUNK_OVERLAP=150
#CORPUS_CONVO_WINDOW=1800

# Skip plain files larger than this many bytes.
#CORPUS_MAX_FILE_BYTES=4194304

# Load config from a different file entirely (must be a real env var, not set
# in the .env file itself).
#CORPUS_ENV_FILE=/path/to/other.env
